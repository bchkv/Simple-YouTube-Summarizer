# Prefer: summarize config set-key  (stores key in ~/.config/summarizer/.env)
# Or set here for development in a repo clone (overrides user config when present):
OPENAI_API_KEY=your_api_key_here

# On-device transcription (--transcribe). Defaults to faster-whisper when installed.
SUMMARIZER_TRANSCRIPTION_BACKEND=faster_whisper
# tiny | base | small | medium | large-v3 | turbo (or full HF repo id)
SUMMARIZER_WHISPER_MODEL=base
SUMMARIZER_WHISPER_DEVICE=cpu
SUMMARIZER_WHISPER_COMPUTE_TYPE=int8

# NVIDIA GPU example:
# SUMMARIZER_WHISPER_DEVICE=cuda
# SUMMARIZER_WHISPER_COMPUTE_TYPE=float16
# SUMMARIZER_WHISPER_MODEL=small

# PDF OCR (optional; requires pip install -e ".[pdf]" and tesseract + poppler)
# SUMMARIZER_PDF_OCR_DPI=200
# SUMMARIZER_PDF_OCR_LANGUAGE=rus
# SUMMARIZER_PDF_FORCE_OCR=1

# Apple Silicon MLX instead of faster-whisper:
# SUMMARIZER_TRANSCRIPTION_BACKEND=mlx_whisper
# SUMMARIZER_WHISPER_MODEL=mlx-community/whisper-small
